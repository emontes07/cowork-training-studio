{% from "prompt.html.j2" import prompt_block %}
<details class="lab anchor" id="{{ lab.id }}"{% if lab_open %} open{% endif %}>
  <summary>
    <span class="lab-meta">{{ lab.minutes }} min / {{ lab.difficulty | capitalize }}</span>
    <h3>{{ lab.title }}</h3>
    <span class="summary-hint">{{ lab.goal }}</span>
  </summary>
  <div class="lab-body">
    <p class="source"><strong>Source:</strong> {{ lab.source }}</p>
    <p>{{ lab.context }}</p>
    {% for exercise in lab.exercises %}
    <section class="exercise" aria-labelledby="{{ lab.id }}--exercise-{{ loop.index }}">
      <h4 id="{{ lab.id }}--exercise-{{ loop.index }}">Exercise {{ loop.index }}</h4>
      <p>{{ exercise.instruction }}</p>
      {{ prompt_block(exercise.prompt, lab.id ~ "--prompt-" ~ loop.index, lab.title ~ ", exercise " ~ loop.index) }}
      <p class="expected"><strong>Expected outcome:</strong> {{ exercise.expected_outcome }}</p>
    </section>
    {% endfor %}
    {% for callout in lab.callouts %}
    <aside class="callout callout-{{ callout.type | replace('_', '-') }}" aria-label="{{ callout.type | replace('_', ' ') | title }}">
      <strong>{{ callout.type | replace('_', ' ') | title }}</strong>
      <p>{{ callout.text }}</p>
    </aside>
    {% endfor %}
    <section class="self-check" aria-labelledby="{{ lab.id }}--check">
      <h4 id="{{ lab.id }}--check">Before you move on</h4>
      <ul>
        {% for check in lab.self_check %}
        <li><label><input type="checkbox"> <span>{{ check }}</span></label></li>
        {% endfor %}
      </ul>
    </section>
  </div>
</details>
