:root {
{% for name, value in theme.items() %}
  {{ name }}: {{ value }};
{% endfor %}
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.65 "Segoe UI", system-ui, sans-serif; }
a { color: var(--brand-secondary); text-underline-offset: .2em; }
button, input { font: inherit; }
button { cursor: pointer; border: 1px solid var(--border); border-radius: .6rem; padding: .5rem .85rem; background: var(--surface); color: var(--brand-primary); font-weight: 600; }
button:hover { border-color: var(--brand-secondary); background: var(--callout-note-bg); }
:focus-visible { outline: 3px solid var(--brand-accent); outline-offset: 4px; }
h1, h2, h3, h4 { line-height: 1.25; color: var(--brand-primary); overflow-wrap: anywhere; }
h1 { margin: .6rem 0 1rem; font-size: clamp(2.2rem, 4vw, 3.6rem); letter-spacing: -.035em; }
h2 { font-size: 1.8rem; margin: .4rem 0 1rem; }
h3 { font-size: 1.25rem; }
h4 { font-size: 1.05rem; }
p { margin: .6rem 0 1rem; overflow-wrap: anywhere; }
li { margin-block: .4rem; overflow-wrap: anywhere; }
.hero { background: linear-gradient(115deg, var(--brand-primary), var(--brand-secondary) 70%, var(--brand-accent)); color: white; }
.hero-inner { max-width: 1440px; margin: auto; padding: 3.5rem 2rem; }
.hero h1 { color: white; max-width: 1000px; }
.eyebrow { text-transform: uppercase; font-weight: 700; font-size: .75rem; letter-spacing: .13em; }
.subtitle { font-size: 1.2rem; max-width: 900px; opacity: .95; }
.tags { display: flex; flex-wrap: wrap; gap: .6rem; list-style: none; padding: 0; margin: 1.6rem 0 0; }
.tags li { border: 1px solid #ffffff66; background: #ffffff19; border-radius: 2rem; padding: .3rem .9rem; font-size: .85rem; }
.layout { max-width: 1440px; margin: auto; padding: 1.75rem 2rem; display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 2rem; align-items: start; }
.sidebar { position: sticky; top: 1rem; max-height: calc(100vh - 2rem); overflow-y: auto; padding: .8rem 0; }
.nav-title { font-weight: 700; padding-inline: .75rem; color: var(--brand-primary); }
.nav-link { display: block; padding: .5rem .75rem; margin: .15rem 0; border-left: 3px solid transparent; border-radius: 0 .4rem .4rem 0; font-size: .9rem; color: var(--muted); text-decoration: none; }
.nav-link:hover, .nav-link.active { background: var(--callout-note-bg); color: var(--brand-primary); border-left-color: var(--brand-accent); }
.scenario-link { font-weight: 700; margin-top: .75rem; }
.lab-link { padding-left: 1.3rem; display: flex; gap: .5rem; justify-content: space-between; }
.lab-link span { white-space: nowrap; font-size: .75rem; }
#studio--nav-toggle { display: none; }
main { min-width: 0; }
.toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.25rem; font-size: .8rem; color: var(--muted); }
.toolbar div { display: flex; gap: .5rem; flex-wrap: wrap; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 1rem; margin-bottom: 1.5rem; padding: 1.75rem; box-shadow: 0 4px 18px #1f386407; }
.anchor { scroll-margin-top: 1.5rem; }
.objectives li { padding-left: .5rem; }
.muted, .summary-hint, .source { color: var(--muted); }
.fictional-badge { display: inline-block; font-size: .8rem; color: var(--brand-primary); background: var(--callout-tip-bg); padding: .25rem .7rem; border-radius: .4rem; }
.resources p { font-size: .9rem; margin-top: .2rem; }
summary { cursor: pointer; list-style-position: outside; margin-left: 1rem; }
summary::marker { color: var(--brand-secondary); }
summary h2, summary h3 { display: inline; }
summary .eyebrow, summary .lab-meta, summary .summary-hint { display: block; }
.summary-hint { font-size: .85rem; margin-top: .4rem; }
.scenario-body { padding-top: 1.5rem; }
.story { margin: 0 0 1.5rem; padding: 1rem; border-left: 4px solid var(--brand-accent); background: var(--bg); border-radius: .5rem; }
.story:empty { display: none; }
.story div { display: grid; grid-template-columns: 125px minmax(0, 1fr); gap: 1rem; margin: .5rem 0; }
dt { font-size: .8rem; font-weight: 700; color: var(--brand-primary); }
dd { margin: 0; font-size: .9rem; overflow-wrap: anywhere; }
.lab { border: 1px solid var(--border); border-radius: .75rem; padding: 1.25rem; margin-top: 1rem; }
.lab[open] > summary { padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
.lab-meta { font-size: .75rem; text-transform: uppercase; font-weight: 700; color: var(--brand-secondary); margin-bottom: .35rem; }
.lab-body { padding-top: .75rem; }
.exercise { margin-top: 1.5rem; }
.prompt-block { border: 1px solid var(--border); border-radius: .65rem; overflow: hidden; margin: 1rem 0; }
.prompt-heading { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .6rem .85rem; background: var(--callout-note-bg); color: var(--brand-primary); font-size: .8rem; font-weight: 700; }
.copy-button { font-size: .8rem; white-space: nowrap; }
pre { margin: 0; padding: 1rem; white-space: pre-wrap; overflow-wrap: anywhere; tab-size: 2; background: #fbfcff; font: .85rem/1.7 ui-monospace, SFMono-Regular, Consolas, monospace; }
code { font: inherit; }
.expected { font-size: .9rem; }
.callout { padding: .9rem 1rem; margin: 1rem 0; border-left: 4px solid var(--brand-secondary); border-radius: .4rem; font-size: .9rem; }
.callout strong { text-transform: uppercase; font-size: .75rem; letter-spacing: .07em; }
.callout p { margin: .3rem 0 0; }
.callout-tip { background: var(--callout-tip-bg); border-color: #26734d; }
.callout-warning { background: var(--callout-warning-bg); border-color: #9b6700; }
.callout-important { background: var(--callout-important-bg); border-color: #b2334d; }
.callout-note { background: var(--callout-note-bg); }
.callout-instructor { background: var(--callout-instructor-bg); border-color: var(--brand-accent); }
.callout-real-world { background: var(--callout-real-world-bg); border-color: #14796f; }
.callout-stretch { background: var(--callout-stretch-bg); border-color: #a53ab8; }
.self-check { padding: 1rem; background: var(--bg); border-radius: .5rem; margin-top: 1.5rem; }
.self-check h4 { margin: 0 0 .75rem; }
.self-check ul { list-style: none; padding: 0; margin: 0; }
.self-check label { display: flex; align-items: baseline; gap: .5rem; cursor: pointer; font-size: .9rem; }
.self-check input { accent-color: var(--brand-accent); }
.page-footer { color: var(--muted); font-size: .8rem; padding: .5rem 0 2rem; }
.copy-status:not(:empty) { position: fixed; bottom: 1rem; right: 1rem; max-width: calc(100vw - 2rem); background: var(--brand-primary); color: white; padding: .75rem 1rem; border-radius: .5rem; box-shadow: 0 4px 18px #0003; z-index: 20; }
.skip-link { position: fixed; left: 1rem; top: -10rem; z-index: 30; padding: .7rem; background: white; }
.skip-link:focus { top: 1rem; }
@media (max-width: 900px) {
  .layout { grid-template-columns: 1fr; gap: .75rem; padding: 1rem; }
  .hero-inner { padding: 2.5rem 1.25rem; }
  .sidebar { position: static; max-height: none; padding: 0; }
  #studio--nav-toggle { display: block; width: 100%; }
  body.js-ready #studio--navigation { display: none; }
  body.js-ready #studio--navigation.is-open { display: block; }
  .card { padding: 1.25rem; }
  .story div { grid-template-columns: 1fr; gap: .1rem; }
  .lab { padding: 1rem; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
@media print {
  body { background: white; color: black; font-size: 10pt; }
  .hero { background: white; color: black; border-bottom: 2px solid black; }
  .hero h1 { color: black; font-size: 24pt; }
  .hero-inner { padding: 0 0 1rem; }
  .tags li { border-color: #888; }
  .layout { display: block; padding: 0; }
  .sidebar, .toolbar, .copy-button, .copy-status, .skip-link { display: none !important; }
  .card, .lab { box-shadow: none; padding: 1rem; }
  details > :not(summary) { display: block !important; }
  details::details-content { content-visibility: visible; display: block; }
  .prompt-block, .callout, .self-check { break-inside: avoid; }
  summary { list-style: none; margin-left: 0; }
  h2, h3, h4 { break-after: avoid; }
  a { color: black; }
}
