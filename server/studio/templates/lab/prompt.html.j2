{% macro prompt_block(prompt, identifier) %}
<div class="prompt-block">
  <div class="prompt-heading">
    <span>{{ prompt.label }} <span class="mode-badge" data-mode="{{ prompt.mode }}">{{ ui["mode_" ~ prompt.mode] }}</span></span>
    <button class="copy-button" type="button" data-copy-target="{{ identifier }}" aria-label="{{ ui.copy_prompt_label }} {{ prompt.label }}">{{ ui.copy_prompt }}</button>
  </div>
  <pre id="{{ identifier }}" tabindex="0"><code>{{ prompt.text }}</code></pre>
</div>
{% endmacro %}
