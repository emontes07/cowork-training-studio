<details class="scenario card anchor" id="{{ scenario.id }}"{% if scenario_open %} open{% endif %}>
  <summary>
    <span class="eyebrow">Scenario {{ scenario_number }}</span>
    <h2>{{ scenario.title }}</h2>
    <span class="summary-hint">{{ scenario.labs | length }} labs / select to expand or collapse</span>
  </summary>
  <div class="scenario-body">
    <dl class="story">
      {% for field, label in story_labels.items() %}
      {% if scenario.story[field] %}
      <div><dt>{{ label }}</dt><dd>{{ scenario.story[field] }}</dd></div>
      {% endif %}
      {% endfor %}
    </dl>
    {% for lab in scenario.labs %}
    {% set lab_open = loop.first %}
    {% include "lab.html.j2" %}
    {% endfor %}
  </div>
</details>
