<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ spec.subtitle }}">
  <title>{{ spec.title }}</title>
  <style>
{% include "styles.css.j2" %}
  </style>
</head>
<body>
  <a class="skip-link" href="#studio--content">Skip to content</a>
  <header class="hero">
    <div class="hero-inner">
      <p class="eyebrow">{{ spec.company.name }} / {{ spec.functional_area }}</p>
      <h1>{{ spec.title }}</h1>
      <p class="subtitle">{{ spec.subtitle }}</p>
      <ul class="tags" aria-label="Session details">
        {% for product in spec.products %}<li>{{ product }}</li>{% endfor %}
        <li>{{ spec.audience }}</li>
        <li>{{ spec.skill_level | capitalize }}</li>
        <li>{{ spec.duration_minutes }} minutes</li>
        <li>{{ stats.chapter_count }} connected chapters</li>
      </ul>
      <div class="leave-with">
        <h2>What you leave with</h2>
        <ul>{% for outcome in spec.narrative.leave_with %}<li>{{ outcome }}</li>{% endfor %}</ul>
      </div>
    </div>
  </header>
  <div class="layout">
    {% include "navigation.html.j2" %}
    <main id="studio--content" tabindex="-1">
      <div class="toolbar" aria-label="Lab controls">
        <span>{{ stats.step_count }} steps / {{ stats.prompt_count }} prompts / {{ stats.challenge_count }} challenges</span>
        <div>
          <button type="button" id="studio--expand">Expand all</button>
          <button type="button" id="studio--collapse">Collapse all</button>
          <button type="button" id="studio--print">Print guide</button>
        </div>
      </div>
      <div class="story-strip">One story, {{ stats.chapter_count }} chapters{% if spec.through_line %} / <strong>{{ spec.through_line.name }}</strong>{% endif %}</div>
      {% include "overview.html.j2" %}
      {% include "agenda.html.j2" %}
      {% include "files.html.j2" %}
      {% for chapter in spec.chapters %}
      {% set chapter_number = loop.index %}
      {% set chapter_open = loop.first %}
      {% include "chapter.html.j2" %}
      {% endfor %}
      {% include "reference.html.j2" %}
      <footer id="disclaimer" class="page-footer">
        <h2>Disclaimer</h2>
        <p>{{ spec.disclaimer }}</p>
        <p>This guide works offline. Linked resources and Copilot itself may require internet access.</p>
      </footer>
    </main>
  </div>
  <p id="studio--copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
  <script>
{% include "behavior.js.j2" %}
  </script>
</body>
</html>
