<!DOCTYPE html>
<html lang="{{ spec.locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ spec.subtitle }}">
  <title>{{ spec.title }}</title>
  <style>
{% include "styles.css.j2" %}
  </style>
</head>
<body>
  <a class="skip-link" href="#studio--content">{{ ui.skip_content }}</a>
  <header class="hero">
    <div class="hero-inner">
      <p class="eyebrow">{{ spec.company.name }} / {{ spec.functional_area }}</p>
      <h1>{{ spec.title }}</h1>
      <p class="subtitle">{{ spec.subtitle }}</p>
      <ul class="tags" aria-label="{{ ui.session_details }}">
        {% for product in spec.products %}<li>{{ product }}</li>{% endfor %}
        <li>{{ spec.audience }}</li>
        <li>{{ ui["level_" ~ spec.skill_level] }}</li>
        <li>{{ spec.duration_minutes }} {{ ui.minutes }}</li>
        <li>{{ stats.chapter_count }} {{ ui.connected_chapters }}</li>
      </ul>
      <div class="leave-with">
        <h2>{{ ui.leave_with }}</h2>
        <ul>{% for outcome in spec.narrative.leave_with %}<li>{{ outcome }}</li>{% endfor %}</ul>
      </div>
    </div>
  </header>
  <div class="layout">
    {% include "navigation.html.j2" %}
    <main id="studio--content" tabindex="-1">
      <div class="toolbar" aria-label="{{ ui.lab_controls }}">
        <span>{{ stats.step_count }} {{ ui.step if stats.step_count == 1 else ui.steps }} / {{ stats.prompt_count }} {{ ui.prompt if stats.prompt_count == 1 else ui.prompts }} / {{ stats.challenge_count }} {{ ui.challenge if stats.challenge_count == 1 else ui.challenges }}</span>
        <div>
          <button type="button" id="studio--expand">{{ ui.expand_all }}</button>
          <button type="button" id="studio--collapse">{{ ui.collapse_all }}</button>
          <button type="button" id="studio--print">{{ ui.print_guide }}</button>
        </div>
      </div>
      <div class="story-strip">{{ ui.one_story }} {{ stats.chapter_count }} {{ ui.chapters }}{% if spec.through_line %} / <strong>{{ spec.through_line.name }}</strong>{% endif %}</div>
      {% include "overview.html.j2" %}
      {% include "agenda.html.j2" %}
      {% include "files.html.j2" %}
      {% for chapter in spec.chapters %}
      {% set chapter_number = loop.index %}
      {% set chapter_open = loop.first %}
      {% include "chapter.html.j2" %}
      {% endfor %}
      {% include "reference.html.j2" %}
      <footer id="disclaimer" class="page-footer">
        <h2>{{ ui.disclaimer }}</h2>
        <p>{{ spec.disclaimer }}</p>
        <p>{{ ui.lab_offline }}</p>
      </footer>
    </main>
  </div>
  <p id="studio--copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
  <script>
{% include "behavior.js.j2" %}
  </script>
</body>
</html>
